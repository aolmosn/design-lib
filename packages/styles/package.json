{
  "name": "@aolmosn/styles",
  "version": "0.1.3",
  "description": "Shared SCSS styles and mixins for design-lib",
  "license": "MIT",
  "author": "Andres Olmos",
  "repository": {
    "type": "git",
    "url": "https://github.com/aolmosn/design-lib"
  },
  "keywords": ["design-system", "scss", "styles"],
  "scripts": {
    "build": "node scripts/generate-manifest.mjs"
  },
  "bin": {
    "styles-purge": "./bin/purge.mjs"
  },
  "exports": {
    ".":          "./src/index.scss",
    "./css":      "./dist/styles.css",
    "./css/min":  "./dist/styles.min.css",
    "./mixins":   "./src/mixins/_breakpoints.scss",
    "./manifest": "./dist/manifest.json"
  },
  "files": ["src", "dist", "scripts", "bin"],
  "publishConfig": {
    "access": "public"
  }
}
