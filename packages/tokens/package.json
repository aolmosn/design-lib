{
  "name": "@aolmosn/tokens",
  "version": "0.1.2",
  "description": "Design tokens (CSS variables and JS constants) for design-lib",
  "license": "MIT",
  "author": "Andres Olmos",
  "repository": {
    "type": "git",
    "url": "https://github.com/aolmosn/design-lib"
  },
  "keywords": ["design-system", "design-tokens", "css-variables"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./css": "./dist/tokens.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "scripts": {
    "generate": "node scripts/generate-tokens.mjs",
    "build": "tsc -p tsconfig.json && cp src/tokens.css dist/tokens.css"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  }
}
